library(rio)
library(tidyverse)
library (ggplot2)
library(dplyr)
library(writexl)
library(tidyr)
library(stringr)
#Añadimos la base de datos de CASOS
fiscalias = import("BD-fiscalias-2025-12.csv")
View(fiscalias)
table(fiscalias$especialidad)
fiscalias<- anticorrupcion %>%
filter(especialidad == "CORRUPCIÓN DE FUNCIONARIOS", "SUPRAPROVINCIAL ESPECIALIZADA EN DELITOS DE CORRUPCIÓN DE FUNCIONARIOS", "NACIONAL ESPECIALIZADA EN DELITOS DE CORRUPCIÓN DE FUNCIONARIOS")
anticorrupcion<- fiscalias %>%
filter(especialidad == "CORRUPCIÓN DE FUNCIONARIOS", "SUPRAPROVINCIAL ESPECIALIZADA EN DELITOS DE CORRUPCIÓN DE FUNCIONARIOS", "NACIONAL ESPECIALIZADA EN DELITOS DE CORRUPCIÓN DE FUNCIONARIOS")
anticorrupcion<- fiscalias %>%
filter(especialidad == "CORRUPCIÓN DE FUNCIONARIOS", "SUPRAPROVINCIAL ESPECIALIZADA EN DELITOS DE CORRUPCIÓN DE FUNCIONARIOS", "NACIONAL ESPECIALIZADA EN DELITOS DE CORRUPCIÓN DE FUNCIONARIOS")
anticorrupcion <- fiscalias %>%
filter(especialidad %in% c("CORRUPCIÓN DE FUNCIONARIOS",
"SUPRAPROVINCIAL ESPECIALIZADA EN DELITOS DE CORRUPCIÓN DE FUNCIONARIOS",
"NACIONAL ESPECIALIZADA EN DELITOS DE CORRUPCIÓN DE FUNCIONARIOS"))
View(anticorrupcion)
