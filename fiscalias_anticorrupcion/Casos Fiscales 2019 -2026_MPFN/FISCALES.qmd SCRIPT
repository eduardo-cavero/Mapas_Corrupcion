```

```{r}
resumen_fiscales_2025 <- fiscales_penales %>%
  filter(anio == 2025) %>%
  mutate(distrito_fiscal = str_trim(str_to_upper(`distrito_fiscal`))) %>%
  group_by(distrito_fiscal) %>%
  summarise(total_fiscales = sum(total, na.rm = TRUE), .groups = 'drop')
```

```{r}
# Unimos ambas tablas mediante el Distrito Fiscal
tabla_carga_laboral <- resumen_casos_2025 %>%
  inner_join(resumen_fiscales_2025, by = "distrito_fiscal") %>%
  mutate(
    # Cálculo de la carga: ¿Cuántas carpetas nuevas tiene cada fiscal al año?
    casos_por_fiscal = round(total_ingresos / total_fiscales, 1)
  ) %>%
  arrange(desc(casos_por_fiscal))
```

```{r}
media_nacional <- mean(tabla_carga_laboral$casos_por_fiscal, na.rm = TRUE)

ggplot(tabla_carga_laboral, aes(x = reorder(distrito_fiscal, casos_por_fiscal), y = casos_por_fiscal)) +
  geom_col(aes(fill = casos_por_fiscal > media_nacional)) +
  geom_hline(yintercept = media_nacional, linetype = "dashed", color = "red") +
  annotate("text", x = 5, y = media_nacional + 50, label = "Media Nacional", color = "red") +
  coord_flip() +
  scale_fill_manual(values = c("TRUE" = "#C0392B", "FALSE" = "#2980B9"), 
                    labels = c("Bajo la media", "Sobre la media")) +
  labs(
    title = "Carga Laboral: Casos Ingresados por Fiscal (2025)",
    subtitle = "Materia Penal - Comparativa por Distrito Fiscal",
    x = "Distrito Fiscal",
    y = "Casos por Fiscal",
    fill = "Estado de Carga"
  ) +
  theme_minimal()
```
