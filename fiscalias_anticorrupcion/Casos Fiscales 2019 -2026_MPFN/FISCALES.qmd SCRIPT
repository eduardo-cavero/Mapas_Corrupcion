```{r}
# 1. Consolidamos el conteo de fiscales usando la columna 'cargo' 
# que es la que define la jerarquía (Provincial, Superior, etc.)
comparativa_fiscales_total <- fiscales_penales %>%
  filter(anio %in% c(2019, 2025)) %>%
  # Limpiamos el texto para asegurar coincidencias
  mutate(cargo = str_trim(str_to_upper(cargo))) %>%
  group_by(anio, cargo) %>%
  summarise(total_fiscales = sum(total, na.rm = TRUE), .groups = 'drop') %>%
  
  # 2. Pasamos los años a columnas
  pivot_wider(names_from = anio, values_from = total_fiscales, names_prefix = "Fiscales_")

# 3. Calculamos totales y variaciones
tabla_final_comparativa <- comparativa_fiscales_total %>%
  bind_rows(
    summarise(., 
              cargo = "TOTAL NACIONAL", 
              Fiscales_2019 = sum(Fiscales_2019, na.rm = TRUE), 
              Fiscales_2025 = sum(Fiscales_2025, na.rm = TRUE))
  ) %>%
  mutate(
    Diferencia_Absoluta = Fiscales_2025 - Fiscales_2019,
    Variacion_Pct = round((Diferencia_Absoluta / Fiscales_2019) * 100, 2)
  )

# Visualizar el resultado
print(tabla_final_comparativa)
```

