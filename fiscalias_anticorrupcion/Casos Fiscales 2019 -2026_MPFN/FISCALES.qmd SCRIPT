# Sub_datos de CASOS

```{r}
# Creamos tabla resumen de carga procesal penal
carga_penal <- casos_penal %>%
  group_by(distrito_fiscal, anio) %>%
  summarise(
    total_ingresados = sum(ingresado, na.rm = TRUE),
    total_atendidos = sum(atendido, na.rm = TRUE),
    .groups = 'drop' 
  ) %>%
  mutate(
    # Calculamos la diferencia (casos que no tuvieron ningún movimiento procesal)
    casos_sin_movimiento = total_ingresados - total_atendidos,
    
    # Calculamos el porcentaje de atención (tasa de respuesta inicial)
    tasa_atencion_pct = round((total_atendidos / total_ingresados) * 100, 2)
  ) %>%
  arrange(anio, desc(total_ingresados)) # Ordenamos por año y de mayor a menor carga
```

```{r}
# Calculamos el resumen nacional con tasas de variación
resumen_evolucion_crecimiento <- casos_penal %>%
  group_by(anio) %>%
  summarise(
    total_ingresados = sum(ingresado, na.rm = TRUE),
    total_tramitados = sum(atendido, na.rm = TRUE),
    .groups = 'drop'
  ) %>%
  arrange(anio) %>%
  mutate(
    # 1. Diferencia absoluta respecto al año anterior
    dif_ingresados = total_ingresados - lag(total_ingresados),
    
    # 2. % de Avance/Crecimiento (Variación Interanual)
    crecimiento_anual_pct = round((dif_ingresados / lag(total_ingresados)) * 100, 2),
    
    # 3. Porcentaje de respuesta anual (Atendidos/Ingresados)
    porcentaje_respuesta = round((total_tramitados / total_ingresados) * 100, 2)
  )
```

```{r}

# Prepararamos los datos sumando todo a nivel nacional
data_nacional <- carga_penal %>%
  group_by(anio) %>%
  summarise(
    Ingresados = sum(total_ingresados, na.rm = TRUE),
    Atendidos = sum(total_atendidos, na.rm = TRUE)
  ) %>%
  # pivot_longer transforma las columnas en filas para que ggplot las lea mejor
  pivot_longer(cols = c(Ingresados, Atendidos), 
               names_to = "Estado", 
               values_to = "Total")

# Creamos el gráfico
grafico_nacional <- ggplot(data_nacional, aes(x = as.factor(anio), y = Total, color = Estado, group = Estado)) +
  geom_line(size = 1.2) +
  geom_point(size = 3) +
  labs(
    title = "Evolución Nacional de la Carga Procesal Penal",
    subtitle = "Brecha entre casos ingresados y casos con movimiento procesal",
    x = "Año",
    y = "Cantidad Total de Casos",
    color = "Estado del Caso"
  ) +
  theme_minimal() +
  # Usamos rojo para el problema (ingresados) y verde/azul para lo avanzado
  scale_color_manual(values = c("Ingresados" = "#E74C3C", "Atendidos" = "#2980B9")) +
  theme(legend.position = "bottom")

# Mostrar el gráfico
print(grafico_nacional)
```

```{r}
# Identificar el último año en la base
ultimo_anio <- max(carga_penal$anio, na.rm = TRUE)

# 2.2 Preparar los datos filtrando año
data_distritos <- carga_penal %>%
  filter(anio == ultimo_anio) %>%
  arrange(desc(total_ingresados)) %>%
  head(35) %>% 
  pivot_longer(cols = c(total_ingresados, total_atendidos), 
               names_to = "Estado", 
               values_to = "Total") %>%
  # Limpiamos los nombres para la leyenda
  mutate(Estado = ifelse(Estado == "total_ingresados", "Ingresados", "Atendidos"))

# 2.3 Crear el gráfico de barras horizontales
grafico_distritos <- ggplot(data_distritos, aes(x = reorder(distrito_fiscal, Total), y = Total, fill = Estado)) +
  # position = "dodge" pone las barras una al lado de la otra
  geom_col(position = "dodge") + 
  coord_flip() + # Voltea el gráfico para leer bien los nombres de los distritos
  labs(
    title = paste("Distritos Fiscales con Mayor Carga Penal en", ultimo_anio),
    subtitle = "Comparativa de casos ingresados vs. atendidos",
    x = "Distrito Fiscal",
    y = "Cantidad de Casos",
    fill = "Estado"
  ) +
  theme_minimal() +
  scale_fill_manual(values = c("Ingresados" = "#E74C3C", "Atendidos" = "#2980B9")) +
  theme(legend.position = "bottom")

# Mostrar el gráfico
print(grafico_distritos)
```

